# --- Storage (required on Vercel) ---------------------------------------
# Add "Upstash for Redis" from Vercel → Storage; these are injected for you.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Scheduling ----------------------------------------------------------
# Vercel sends this as a Bearer token to /api/cron. Any long random string.
CRON_SECRET=

# --- Notifications (set any or all) -------------------------------------
SLACK_WEBHOOK_URL=
RESEND_API_KEY=
NOTIFY_EMAIL_TO=you@example.com,teammate@example.com
NOTIFY_EMAIL_FROM=Festive Monitor <alerts@yourdomain.com>
NOTIFY_WEBHOOK_URL=

# --- Optional ------------------------------------------------------------
# Protect the dashboard with a password (HTTP Basic auth, user "admin").
DASHBOARD_PASSWORD=
DASHBOARD_URL=
SITE_URL=https://festive.fivehotelsandresorts.com
